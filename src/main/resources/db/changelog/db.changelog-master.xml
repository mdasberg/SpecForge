<?xml version="1.0" encoding="UTF-8"?>
<!--
  One changelog per Modulith module, included in dependency order. A module gets its file when it
  gets its first table; nothing else may write into another module's changelog.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="db/changelog/platform/changelog.xml" relativeToChangelogFile="false"/>

</databaseChangeLog>
