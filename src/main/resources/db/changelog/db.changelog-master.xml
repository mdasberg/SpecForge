<?xml version="1.0" encoding="UTF-8"?>
<!--
  One include per version file, oldest first. A changeset is never moved between version files once
  released: Liquibase identifies a changeset by id, author and file, so moving one makes it a
  different changeset and it runs again on every database that already had it.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="db/changelog/v1.0.xml" relativeToChangelogFile="false"/>

</databaseChangeLog>
