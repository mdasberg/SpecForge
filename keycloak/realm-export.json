            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "specforge-check-reviewer",
      "name": "Model-backed spec review runner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "specforge-check-reviewer-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
